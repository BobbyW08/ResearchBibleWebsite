# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string used by Payload CMS.
# Point at the "preview" Neon branch for local dev and Vercel Preview deploys.
# Never use the production connection string outside of Vercel Production env vars.
DATABASE_URI=

# ── Payload CMS ───────────────────────────────────────────────────────────────
# Secret used to sign Payload JWTs and cookies. Generate a long random string.
PAYLOAD_SECRET=

# ── Neon Auth (visitor authentication) ────────────────────────────────────────
# Base URL for Neon Auth API endpoints (provided by Neon Auth console).
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_BASE_URL=

# Secret used to sign Neon Auth session cookies.
NEON_AUTH_COOKIE_SECRET=

# ── Google Service Account (Drive + Sheets integration) ───────────────────────
# Service account email from the Google Cloud Console credentials JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key (the full PEM block, newlines as \n).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Sheets spreadsheet ID for interest signup data.
INTEREST_SIGNUPS_SHEET_ID=

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Shared secret for the research bible Drive content sync webhook.
# Must match the webhookSecret value in the Apps Script CONFIG.
# IMPORTANT: rotate this value if it has ever been committed to git history.
WEBHOOK_SECRET=

# Shared secret for the parent-facing content sync webhook.
# Separate from WEBHOOK_SECRET. Set independently in Vercel and its own Apps Script project.
PARENT_CONTENT_WEBHOOK_SECRET=

# ── Email (community report notifications) ────────────────────────────────────
# Resend API key for transactional email. Not yet configured at launch.
RESEND_API_KEY=

# Email address that receives community report notifications.
NOTIFY_EMAIL=
